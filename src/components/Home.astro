---
import { labels, formatDate, readingTime, summary, type Entry, type Lang } from '../lib/site';
interface Props {
  lang: Lang;
  entries: Entry[];
}
const { lang, entries } = Astro.props;
const t = labels[lang];
const posts = entries.filter((p) => p.data.lang === lang && p.data.type === 'post');
const [latest] = posts;
---

<section class="hero shell">
  <div class="hero-main">
    <p class="eyebrow">
      <span class="status-dot"></span>
      {t.eyebrow}
    </p>
    <h1>
      {t.hero[0]}
      <br />
      <span>
        {t.hero[1]}
        <span class="technical-cursor" aria-hidden="true">
          _
        </span>
      </span>
      <br />
      {t.hero[2]}
    </h1>
  </div>
  <div class="hero-aside">
    <div class="hero-symbol" aria-hidden="true">
      <span>ƒ</span>
      <i>→</i>
      <span>g</span>
    </div>
    <p>{t.intro}</p>
    <a class="text-link" href={t.about}>
      {lang === 'es' ? 'Sobre mí' : 'More about me'} <span aria-hidden="true">↗</span>
    </a>
    <dl class="technical-stats technical-only">
      <div>
        <dt>{lang === 'es' ? 'Artículos' : 'Articles'}</dt>
        <dd>{String(posts.length).padStart(2, '0')}</dd>
      </div>
      <div>
        <dt>{lang === 'es' ? 'Desde' : 'Since'}</dt>
        <dd>{Math.min(...posts.map((p) => p.data.date.getUTCFullYear()))}</dd>
      </div>
      <div>
        <dt>{lang === 'es' ? 'Idiomas' : 'Languages'}</dt>
        <dd>EN / ES</dd>
      </div>
    </dl>
    <span class="hero-note">C++ · GENERIC PROGRAMMING · MATHEMATICS</span>
  </div>
</section>
<section class="featured-section shell" aria-labelledby="featured-title">
  <div class="section-label">
    <span class="eyebrow">01 / {t.latest}</span>
    <a class="small-link" href={lang === 'es' ? '/feed-es.xml' : '/feed.xml'}>
      {t.rss} ↗
    </a>
  </div>
  {latest && (
    <a
      class:list={['featured-story', { 'without-cover': !latest.data.cover }]}
      href={latest.data.url}
    >
      <div class="featured-copy">
        <div class="story-meta">
          <span class="category-label">
            {latest.data.topic || latest.data.tags[0] || 'NOTEBOOK'}
          </span>
          <time datetime={latest.data.date.toISOString()}>
            {formatDate(latest.data.date, lang)}
          </time>
        </div>
        <h2 id="featured-title">{latest.data.title}</h2>
        <p>{summary(latest)}</p>
        <span class="read-link">
          {t.read}
          <span aria-hidden="true">↗</span>
        </span>
      </div>
      {latest.data.cover && (
        <div class="featured-visual">
          <img
            src={latest.data.cover.src}
            alt={latest.data.cover.alt}
            width="1200"
            height="700"
            fetchpriority="high"
          />
          {latest.data.cover.caption && (
            <span class="photo-caption">{latest.data.cover.caption}</span>
          )}
        </div>
      )}
    </a>
  )}
</section>
<section id="writing" class="archive-section shell" aria-labelledby="archive-title">
  <div class="archive-heading">
    <div>
      <p class="eyebrow">02 / {t.archive}</p>
      <h2 id="archive-title">
        {lang === 'es' ? 'Ideas, notas y descubrimientos.' : 'Ideas, notes & discoveries.'}
      </h2>
    </div>
    <label class="search">
      <span class="sr-only">{t.search}</span>
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <circle cx="10" cy="10" r="6" />
        <path d="m15 15 5 5" />
      </svg>
      <input
        id="article-search"
        type="search"
        placeholder={t.search}
        aria-controls="article-list"
      />
    </label>
  </div>
  <div class="archive-layout">
    <aside class="archive-sidebar">
      <p class="archive-count">
        <strong>{posts.length}</strong>
        <span>{lang === 'es' ? 'artículos publicados' : 'published articles'}</span>
      </p>
      <p>
        {lang === 'es'
          ? 'Un archivo de ideas sobre cómo pensamos, diseñamos y programamos.'
          : 'An ongoing collection of ideas on how we think, design, and program.'}
      </p>
      <a class="text-link" href="/writing-min-function-part1/">
        {t.seriesTitle}
        <span aria-hidden="true">↗</span>
      </a>
      <span class="small-note">
        {lang === 'es' ? 'Serie de 5 artículos · en inglés' : 'A five-part series'}
      </span>
    </aside>
    <div>
      <div id="article-list" class="article-list">
        {posts.map((post, index) => (
          <article
            class="article-row"
            data-search={`${post.data.title} ${summary(post)} ${post.data.tags.join(' ')}`.toLocaleLowerCase(
              lang,
            )}
          >
            <span class="row-number" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <div class="row-content">
              <div class="story-meta">
                <time datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date, lang)}
                </time>
                <span>
                  {readingTime(post)} {t.minutes}
                </span>
              </div>
              <h3>
                <a href={post.data.url}>
                  {post.data.title}
                  <span class="row-arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              </h3>
              <p>{summary(post)}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="empty-results" role="status" hidden>
        {t.empty}
      </p>
      <p class="sr-only" id="search-count" role="status" aria-live="polite"></p>
    </div>
  </div>
</section>
<section class="lab-callout shell">
  <div>
    <span class="eyebrow">03 / AL-KHWĀRIZMĪ</span>
    <h2>{t.labTitle}</h2>
    <p>{t.labDescription}</p>
    <a href={lang === 'es' ? '/algoritmos/' : '/algorithms/'}>
      {t.labLink}
      <span aria-hidden="true">↗</span>
    </a>
  </div>
  <div class="lab-diagram" aria-hidden="true">
    <div class="diagram-rule"></div>
    {[5, 2, 8, 1, 6].map((n, i) => (
      <div style={`--index:${i}`}>
        <span>{n}</span>
        <small>{i}</small>
      </div>
    ))}
    <span class="diagram-label">[ FIRST, LAST )</span>
  </div>
</section>
<script>
  const input = document.querySelector<HTMLInputElement>('#article-search');
  const rows = [...document.querySelectorAll<HTMLElement>('.article-row')];
  input?.addEventListener('input', () => {
    const query = input.value
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLocaleLowerCase()
      .trim();
    let count = 0;
    rows.forEach((row) => {
      const searchable = (row.dataset.search || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');
      row.hidden = !searchable.includes(query);
      if (!row.hidden) count++;
    });
    const empty = document.querySelector<HTMLElement>('.empty-results');
    if (empty) empty.hidden = count !== 0;
    const status = document.querySelector('#search-count');
    if (status) status.textContent = `${count}`;
  });
</script>
