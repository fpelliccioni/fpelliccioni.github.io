---
import { firstExamplePage, firstPage, lastPage, officialPdf, pageLabel, sections } from '../lab/eop-book';

interface Props { lang: 'es' | 'en' }
const { lang } = Astro.props;
const es = lang === 'es';
const labPath = es ? '/algoritmos/' : '/algorithms/';
const alternatePath = es ? '/interactive-eop/' : '/eop-interactivo/';
const pages = Array.from({ length: lastPage - firstPage + 1 }, (_, i) => i + firstPage);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{es ? 'Elements of Programming interactivo' : 'Interactive Elements of Programming'}</title>
    <meta name="description" content={es ? 'Leé Elements of Programming y ejecutá los algoritmos disponibles paso a paso.' : 'Read Elements of Programming and step through the available algorithms.'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/assets/css/algorithms/lab.css" />
  </head>
  <body>
    <main id="eop-reader" data-lab-path={labPath}>
      <header class="reader-header">
        <div>
          <h1>Elements of Programming</h1>
        </div>
        <div class="reader-views" role="group" aria-label={es ? 'Vista del lector' : 'Reader view'}>
          <button type="button" data-reader-view="pdf" aria-pressed="false">PDF</button>
          <button type="button" data-reader-view="split" aria-pressed="true">{es ? 'Partida' : 'Split'}</button>
          <button type="button" data-reader-view="lab" aria-pressed="false">Lab</button>
        </div>
        <nav aria-label={es ? 'Navegación' : 'Navigation'}>
          <button type="button" id="book-open-algorithms" aria-haspopup="dialog" aria-controls="book-algorithms">
            {es ? 'Buscar algoritmo' : 'Find algorithm'} <span aria-hidden="true">⌕</span>
          </button>
          <a href={labPath}>{es ? 'Laboratorio' : 'Algorithm lab'}</a>
          <a href={alternatePath} hreflang={es ? 'en' : 'es'} lang={es ? 'en' : 'es'}>{es ? 'English' : 'Español'}</a>
        </nav>
      </header>

      <div class="reader-layout" data-view="split">
        <section class="reader-panel book" aria-label={es ? 'Libro' : 'Book'}>
          <div class="book-toolbar">
            <button type="button" id="book-previous" aria-label={es ? 'Página anterior' : 'Previous page'}>←</button>
            <label for="book-page">{es ? 'Página' : 'Page'}</label>
            <select id="book-page">
              {pages.map(page => <option value={page} selected={page === firstExamplePage}>{pageLabel(page)}</option>)}
            </select>
            <button type="button" id="book-next" aria-label={es ? 'Página siguiente' : 'Next page'}>→</button>
            <button type="button" id="book-open-chapters" aria-haspopup="dialog" aria-controls="book-chapters">{es ? 'Capítulos' : 'Chapters'}</button>
            <a id="book-official" href={officialPdf} target="_blank" rel="noopener">{es ? 'Abrir PDF oficial ↗' : 'Open official PDF ↗'}</a>
          </div>
          <div id="book-pdf-stage" role="region" aria-label={es ? 'Páginas de Elements of Programming' : 'Elements of Programming pages'} tabindex="0">
            {pages.map(page => <div class="book-pdf-page" data-page={page}></div>)}
          </div>
        </section>

        <section class="reader-panel analyzer" aria-label={es ? 'Laboratorio' : 'Algorithm lab'}>
          <div id="book-examples" role="group" aria-label={es ? 'Algoritmos de la página' : 'Algorithms on this page'}></div>
          <p id="book-notice" role="status" hidden></p>
          <iframe id="book-lab" title={es ? 'Laboratorio de algoritmos' : 'Algorithm lab'} hidden></iframe>
        </section>

        <button class="reader-view-peek" type="button" data-focus-panel="pdf" aria-label={es ? 'Dar foco al PDF' : 'Focus the PDF'}><span>PDF</span></button>
        <button class="reader-view-peek" type="button" data-focus-panel="lab" aria-label={es ? 'Dar foco al lab' : 'Focus the lab'}><span>Lab</span></button>
      </div>
      <dialog id="book-chapters" class="algorithm-catalog" aria-labelledby="book-chapters-title">
        <div class="catalog-heading">
          <h2 id="book-chapters-title">{es ? 'Capítulos y secciones' : 'Chapters and sections'}</h2>
          <form method="dialog">
            <button class="catalog-close" aria-label={es ? 'Cerrar capítulos' : 'Close chapters'}>×</button>
          </form>
        </div>
        <ul class="book-chapter-list">
          {sections.map(([page, en, spanish]) => (
            <li><button type="button" data-chapter-page={page}>
              <span>{es ? spanish : en}</span><small>{es ? 'pág.' : 'p.'} {pageLabel(page)}</small>
            </button></li>
          ))}
        </ul>
      </dialog>
      <dialog id="book-algorithms" class="algorithm-catalog" aria-labelledby="book-algorithms-title">
        <div class="catalog-heading">
          <h2 id="book-algorithms-title">{es ? 'Catálogo de algoritmos' : 'Algorithm catalog'}</h2>
          <form method="dialog">
            <button class="catalog-close" aria-label={es ? 'Cerrar catálogo' : 'Close catalog'}>×</button>
          </form>
        </div>
        <label class="catalog-search-label" for="book-algorithm">{es ? 'Buscar por nombre' : 'Search by name'}</label>
        <input class="catalog-search" id="book-algorithm" type="search" placeholder="lower_bound" autocomplete="off" autofocus />
        <p class="catalog-count" id="book-nav-count" role="status"></p>
        <ul class="catalog-results" id="book-nav-results"></ul>
      </dialog>
      <noscript><p>{es ? 'Activá JavaScript para usar el lector y los ejemplos.' : 'Enable JavaScript to use the reader and examples.'}</p></noscript>
    </main>
    <script>
      import '../lab/eop-reader';
    </script>
  </body>
</html>

<style is:global>
  body:has(#eop-reader) { margin: 0; background: #0c1118; color: #e3edf5; }
  #eop-reader { max-width: 1920px; margin-inline: auto; padding: 16px clamp(10px, 2vw, 28px); font: 14px/1.5 var(--sans, system-ui); }
  #eop-reader [hidden] { display: none !important; }
  #eop-reader a { color: #c4e69f; }
  #eop-reader a:hover { text-decoration: underline; }
  .reader-header, .book-toolbar { display: flex; align-items: center; gap: 9px 12px; flex-wrap: wrap; }
  .reader-header { justify-content: space-between; padding: 0 1px 14px; }
  .reader-header h1 { font-size: clamp(21px, 2.3vw, 30px); letter-spacing: -.035em; margin: 0; }
  .reader-header nav { display: flex; align-items: center; flex-wrap: wrap; gap: 10px 16px; }
  .reader-views { display: flex; gap: 4px; }
  #eop-reader .reader-views [aria-pressed="true"] { border-color: #b1ed80; color: #c4e69f; }
  .reader-layout { --peek: clamp(46px, 7vw, 100px); position: relative; display: grid; grid-template-columns: minmax(330px, 44fr) minmax(0, 56fr); gap: 14px; }
  .reader-layout[data-view="pdf"] > .reader-panel,
  .reader-layout[data-view="lab"] > .reader-panel { grid-area: 1 / 1 / 2 / -1; }
  .reader-layout[data-view="pdf"] > .book,
  .reader-layout[data-view="lab"] > .analyzer { width: calc(100% - var(--peek)); z-index: 1; box-shadow: 0 8px 24px #0007; }
  .reader-layout[data-view="lab"] > .book { width: 44%; opacity: .55; }
  .reader-layout[data-view="pdf"] > .analyzer { width: 56%; opacity: .55; }
  .reader-layout[data-view="lab"] > .analyzer,
  .reader-layout[data-view="pdf"] > .analyzer { justify-self: end; }

  #eop-reader .reader-view-peek {
    display: none;
    position: absolute;
    z-index: 2;
    inset-block: 0;
    width: var(--peek);
    align-items: center;
    justify-content: center;
    padding: 8px 2px;
    background: transparent;
    border: 0;
  }
  #eop-reader .reader-view-peek span { padding: 3px 6px; border: 1px solid #40576a; border-radius: 4px; background: #111b26; }
  #eop-reader [data-view="lab"] [data-focus-panel="pdf"] { display: flex; inset-inline-start: 0; }
  #eop-reader [data-view="pdf"] [data-focus-panel="lab"] { display: flex; inset-inline-end: 0; }
  .reader-panel { display: flex; min-width: 0; flex-direction: column; height: max(580px, calc(100dvh - 118px)); border: 1px solid #2a3c4b; border-radius: 8px; overflow: hidden; background: #111b26; }
  .book-toolbar { padding: 10px 12px; border-bottom: 1px solid #2a3c4b; }
  .book-toolbar a { margin-inline-start: auto; }
  #eop-reader button, #eop-reader select { font: inherit; border: 1px solid #40576a; border-radius: 5px; color: inherit; background: #172531; padding: 4px 9px; }
  #eop-reader select { width: auto; min-width: 60px; }
  #eop-reader dialog { box-sizing: border-box; }
  #eop-reader .catalog-heading { align-items: center; margin-bottom: 12px; }
  #eop-reader .catalog-close { font-size: 22px; line-height: 1; }
  #eop-reader .catalog-results, .book-chapter-list { list-style: none; margin: 0; padding: 0; }
  #eop-reader #book-nav-results .catalog-card { width: 100%; height: 100%; padding: 12px; border-color: var(--border); background: var(--bg); text-align: start; overflow-wrap: anywhere; }
  #book-nav-results .catalog-name { margin: 6px 0 10px; font: 13px/1.5 var(--mono); }
  #book-chapters { width: min(550px, calc(100% - 32px)); }
  .book-chapter-list { display: grid; gap: 5px; }
  .book-chapter-list button { width: 100%; display: flex; justify-content: space-between; align-items: baseline; gap: 10px; text-align: start; }
  #eop-reader .book-chapter-list button[aria-current], #eop-reader #book-nav-results .catalog-card:hover { border-color: var(--accent); }
  .book-chapter-list small { flex: none; color: var(--muted); }
  #eop-reader button:not(:disabled) { cursor: pointer; }
  #eop-reader button:disabled { opacity: .4; }
  #eop-reader :focus-visible { outline: 2px solid #b1ed80; outline-offset: 2px; }
  #book-pdf-stage { flex: 1; overflow: auto; min-height: 0; background: #262626; }
  .book-pdf-page { aspect-ratio: 2 / 3; }
  .book-pdf-page + .book-pdf-page { margin-top: 8px; }
  .book-pdf-page iframe, #book-lab { border: 0; display: block; width: 100%; }
  .book-pdf-page iframe { height: 100%; pointer-events: none; }
  #book-lab { flex: 1; min-height: 0; background: #0c1118; }
  #book-examples { max-height: 30%; overflow: auto; display: flex; flex-wrap: wrap; gap: 6px; padding: 7px 10px; border-bottom: 1px solid #2a3c4b; }
  #book-examples button { max-width: 100%; overflow-wrap: anywhere; text-align: start; font: 12px/1.55 var(--mono, monospace); }
  #book-examples button[aria-pressed="true"] { border-color: #b1ed80; color: #c4e69f; }
  #book-examples small { display: inline-block; margin-inline-start: 7px; color: #a4b7c9; }
  #book-examples p, #book-notice { color: #a4b7c9; margin: 0; }
  #book-notice { padding: 22px 12px; }
  @media (max-width: 830px) {
    .reader-layout { grid-template-columns: minmax(0, 1fr); }
    .reader-panel { height: max(480px, 75dvh); }
    .analyzer { height: max(620px, 90dvh); }
    .reader-layout[data-view="pdf"] > .reader-panel,
    .reader-layout[data-view="lab"] > .reader-panel { height: max(520px, calc(100dvh - 118px)); }
    .reader-layout[data-view="lab"] > .book,
    .reader-layout[data-view="pdf"] > .analyzer { width: calc(100% - var(--peek)); }
  }
</style>
