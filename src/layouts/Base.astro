---
import '../styles/global.css';
import '../styles/technical.css';
import { DEFAULT_DESIGN } from '../lib/design';
import { NAME, absolute, labels, type Lang } from '../lib/site';
interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  url?: string;
  translations?: { lang: Lang; url: string }[];
  article?: boolean;
  published?: Date;
  noindex?: boolean;
}
const {
  title,
  description,
  lang = 'en',
  url = Astro.url.pathname,
  translations = [],
  article = false,
  published,
  noindex = false,
} = Astro.props;
const t = labels[lang];
const other = translations.find((p) => p.lang !== lang);
const switchUrl = other?.url || (lang === 'en' ? '/inicio/' : '/');
const feed = lang === 'es' ? '/feed-es.xml' : '/feed.xml';
---

<!doctype html>
<html
  lang={lang}
  data-design={DEFAULT_DESIGN}
  data-default-design={DEFAULT_DESIGN}
  data-theme="dark"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === NAME ? NAME : `${title} — ${NAME}`}</title>
    <meta name="description" content={description || t.description} />
    <link rel="canonical" href={absolute(url)} />
    {translations.map((p) => (
      <link rel="alternate" hreflang={p.lang} href={absolute(p.url)} />
    ))}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description || t.description} />
    <meta property="og:url" content={absolute(url)} />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:image" content={absolute('/social-card.png')} />
    <meta name="twitter:card" content="summary" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/atom+xml" title={`${NAME} (${lang})`} href={feed} />
    <meta name="theme-color" content="#0c1118" />
    <script is:inline>
      try {
        const requested = new URLSearchParams(location.search).get('design');
        if (requested === 'technical' || requested === 'editorial')
          sessionStorage.setItem('cp-design-preview', requested);
        const design = sessionStorage.getItem('cp-design-preview');
        if (design === 'technical' || design === 'editorial') {
          document.documentElement.dataset.designPreview = 'true';
          document.documentElement.dataset.design = design;
        }
        const technical = document.documentElement.dataset.design === 'technical';
        const color = localStorage.getItem(technical ? 'cp-technical-theme' : 'cp-theme');
        document.documentElement.dataset.theme =
          color === 'light' || color === 'dark' ? color : technical ? 'dark' : 'light';
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}
    </a>
    <header class="site-header shell">
      <a class="wordmark" href={t.home} aria-label={NAME}>
        <span class="brand-mark" aria-hidden="true">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 64 64"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M10 13V51M22 14L57 28"
              stroke="currentColor"
              stroke-width="4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M57 28L22 48"
              stroke="var(--accent, currentColor)"
              stroke-width="4"
              stroke-linecap="round"
            />
          </svg>
        </span>
        <span>
          Components
          <br />
          Programming
        </span>
      </a>
      <div class="header-actions">
        <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav">
          {t.menu}
          <span aria-hidden="true">＋</span>
        </button>
        <nav id="main-nav" aria-label={t.menu}>
          <a href={`${t.home}#writing`}>{t.navArticles}</a>
          <a href={t.about}>{t.navAbout}</a>
          <a class="lab-nav" href={lang === 'es' ? '/algoritmos/' : '/algorithms/'}>
            {t.navAlgorithms}
            <span aria-hidden="true">↗</span>
          </a>
        </nav>
        <div class="utility-nav">
          <a
            class="language-switch"
            href={switchUrl}
            lang={lang === 'en' ? 'es' : 'en'}
            hreflang={lang === 'en' ? 'es' : 'en'}
          >
            {lang === 'en' ? 'ES' : 'EN'}
          </a>
          <button class="theme-toggle" aria-label={t.theme} title={t.theme}>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="8" />
              <path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor" stroke="none" />
            </svg>
          </button>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer shell">
      <div class="footer-top">
        <a class="footer-title" href={t.home}>
          Components
          <br />
          Programming<span>↗</span>
        </a>
        <p>
          {t.footer}
          <br />
          <span>Fernando Pelliccioni</span>
        </p>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getUTCFullYear()} Fernando Pelliccioni</span>
        <div>
          <a href={t.contact}>{t.navContact}</a>
          <a href={t.donate}>{t.navDonate}</a>
          <a href={feed}>RSS</a>
          <a href="https://github.com/fpelliccioni/fpelliccioni.github.io">GitHub ↗</a>
        </div>
      </div>
    </footer>
    <aside
      class="design-preview"
      aria-label={lang === 'es' ? 'Comparar diseños' : 'Compare designs'}
    >
      <span>{lang === 'es' ? 'Vista previa' : 'Design preview'}</span>
      <div role="group" aria-label={lang === 'es' ? 'Diseño' : 'Design'}>
        <button type="button" data-design-choice="editorial" aria-pressed="true">
          Editorial
        </button>
        <button type="button" data-design-choice="technical" aria-pressed="false">
          {lang === 'es' ? 'Técnico' : 'Technical'}
        </button>
      </div>
      <button
        type="button"
        class="close-design-preview"
        aria-label={lang === 'es' ? 'Cerrar vista previa' : 'Close design preview'}
      >
        ×
      </button>
    </aside>
    <script src="../scripts/design-preview.ts"></script>
    <script>
      const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#main-nav');
      if (menu && nav) {
        document.documentElement.classList.add('has-js');
        menu.addEventListener('click', () => {
          const open = menu.getAttribute('aria-expanded') !== 'true';
          menu.setAttribute('aria-expanded', String(open));
          nav.classList.toggle('is-open', open);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            menu.setAttribute('aria-expanded', 'false');
            nav.classList.remove('is-open');
          }
        });
      }
    </script>
  </body>
</html>
